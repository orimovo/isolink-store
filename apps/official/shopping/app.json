{
  "id": "shopping",
  "name": "Shopping",
  "icon": "shopping_cart",
  "accent": 4280265073,
  "main": "src/app.tsx",
  "schema": {
    "name": "Shopping",
    "icon": "shopping_cart",
    "tables": {
      "items": {
        "title": "name",
        "order": "pos",
        "fields": {
          "name": { "id": 1, "type": "text", "max": 80, "required": true, "search": true },
          "qty": { "id": 2, "type": "text", "max": 20 },
          "aisle": { "id": 3, "type": "choice", "options": [
            { "id": "fruit", "name": "Fruit & veg" },
            { "id": "bakery", "name": "Bakery" },
            { "id": "dairy", "name": "Dairy" },
            { "id": "meat", "name": "Meat & fish" },
            { "id": "cupboard", "name": "Cupboard" },
            { "id": "frozen", "name": "Frozen" },
            { "id": "drinks", "name": "Drinks" },
            { "id": "home", "name": "Home" },
            { "id": "other", "name": "Other" }
          ] },
          "got": { "id": 4, "type": "bool", "index": true, "default": false },
          "pos": { "id": 5, "type": "order" }
        }
      },
      "usuals": {
        "title": "name",
        "fields": {
          "name": { "id": 1, "type": "text", "max": 80, "required": true, "search": true },
          "aisle": { "id": 2, "type": "choice", "options": ["fruit", "bakery", "dairy", "meat", "cupboard", "frozen", "drinks", "home", "other"] }
        }
      }
    }
  }
}
