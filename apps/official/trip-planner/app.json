{
  "id": "trip-planner",
  "name": "Trip planner",
  "icon": "calendar",
  "accent": 4281558271,
  "main": "src/app.tsx",
  "version": 2,
  "needs": {
    "web": [
      "api.open-meteo.com"
    ]
  },
  "summary": {
    "table": "trips",
    "none": "No trips yet",
    "one": "1 trip",
    "many": "{p0} trips"
  },
  "schema": {
    "tables": {
      "plans": {
        "name": "Plans",
        "title": "what",
        "fields": {
          "what": {
            "id": 1,
            "type": "text",
            "max": 120,
            "required": true
          },
          "day": {
            "id": 2,
            "type": "date"
          },
          "kind": {
            "id": 3,
            "type": "choice",
            "options": [
              {
                "id": "travel",
                "name": "Travel"
              },
              {
                "id": "stay",
                "name": "Stay"
              },
              {
                "id": "eat",
                "name": "Eat"
              },
              {
                "id": "do",
                "name": "Do"
              }
            ]
          },
          "who": {
            "id": 4,
            "type": "person"
          },
          "booked": {
            "id": 5,
            "type": "bool",
            "default": false
          },
          "link": {
            "id": 6,
            "type": "link"
          },
          "cost": {
            "id": 7,
            "type": "number",
            "decimals": 2
          },
          "trip": {
            "id": 8,
            "type": "ref",
            "table": "trips",
            "index": true
          },
          "time": {
            "id": 9,
            "type": "text",
            "max": 5
          },
          "place": {
            "id": 10,
            "type": "place"
          },
          "ticket": {
            "id": 11,
            "type": "file"
          },
          "pos": {
            "id": 12,
            "type": "order"
          }
        }
      },
      "packing": {
        "name": "Packing",
        "title": "item",
        "fields": {
          "item": {
            "id": 1,
            "type": "text",
            "max": 80,
            "required": true
          },
          "packed": {
            "id": 2,
            "type": "bool",
            "default": false
          },
          "who": {
            "id": 3,
            "type": "person"
          },
          "trip": {
            "id": 4,
            "type": "ref",
            "table": "trips",
            "index": true
          },
          "pos": {
            "id": 5,
            "type": "order"
          }
        },
        "order": "pos"
      },
      "trips": {
        "name": "Trips",
        "title": "name",
        "fields": {
          "name": {
            "id": 1,
            "type": "text",
            "max": 80,
            "required": true
          },
          "emoji": {
            "id": 2,
            "type": "text",
            "max": 8
          },
          "place": {
            "id": 3,
            "type": "place"
          },
          "start": {
            "id": 4,
            "type": "date"
          },
          "end": {
            "id": 5,
            "type": "date"
          },
          "currency": {
            "id": 6,
            "type": "text",
            "max": 3
          }
        }
      },
      "costs": {
        "name": "Costs",
        "title": "what",
        "fields": {
          "what": {
            "id": 1,
            "type": "text",
            "max": 120,
            "required": true
          },
          "amount": {
            "id": 2,
            "type": "number",
            "decimals": 2,
            "min": 0
          },
          "paid": {
            "id": 3,
            "type": "person"
          },
          "split": {
            "id": 4,
            "type": "person",
            "many": true
          },
          "trip": {
            "id": 5,
            "type": "ref",
            "table": "trips",
            "index": true
          },
          "day": {
            "id": 6,
            "type": "date"
          }
        }
      }
    }
  },
  "starter": {
    "packing": [
      {
        "item": "Passports"
      },
      {
        "item": "Chargers"
      },
      {
        "item": "Toothbrush"
      }
    ]
  }
}
